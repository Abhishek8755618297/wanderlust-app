<% layout("/layouts/boilerplate") %>
  

 <div id="filters">

  <div class="filter">
    <a href="/listings/filter/Trending">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </a>
  </div> 
   
  <div class="filter">
    <a href="/listings/filter/Rooms">
      <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Iconic-Cities">
      <div><i class="fa-solid fa-city"></i></div>
      <p>Iconic Cities</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Mountains">
      <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Castles">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Camping">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Amazing-Pools">
      <div><i class="fa-solid fa-person-swimming me-2"></i></div>
      <p>Amazing Pools</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Arctic">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Farm">
      <div><i class="fa-solid fa-cow me-2"></i></div>
      <p>Farm</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/filter/Boat">
      <div><i class="fa-solid fa-ship"></i></div>
      <p>Boat</p>
    </a>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>





  <!-- styling index cards -->
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
          <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            alt="listing_image"
            style="height: 20rem"
          />
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %> <br /></b>
              &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
              <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>


