<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
    <h3 class="mb-3 text-center">Create a New Listing</h3>

    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="Add a catchy title"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          rows="3"
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <!-- Image -->
      <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image</label>
        <input
          name="listing[image]"
          type="file"
          class="form-control"
          required
        />
      </div>

      <!-- Category Dropdown -->
      <div class="mb-3">
        <label class="form-label">Choose Category</label>

        <button type="button" class="btn btn-outline-secondary w-100 text-start" id="categoryToggle">
          Choose Category
        </button>

        <div id="categoryOptions" class="border rounded p-3 mt-2 d-none"
          style="max-height: 300px; overflow-y: auto; background-color: #fff;">

          <div class="row">  
            <!-- Left Column -->
            <div class="col-md-6">
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="rooms" name="listing[category]" value="Rooms" required>
                <label class="form-check-label d-flex align-items-center" for="rooms">
                  <i class="fa-solid fa-bed me-2"></i> Rooms
                </label>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="iconic-cities" name="listing[category]" value="Iconic-Cities" required>
                <label class="form-check-label d-flex align-items-center" for="iconic-cities">
                  <i class="fa-solid fa-mountain-city me-2"></i> Iconic Cities
                </label>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="mountains" name="listing[category]" value="Mountains" required>
                <label class="form-check-label d-flex align-items-center" for="mountains">
                  <i class="fa-solid fa-mountain-sun me-2"></i> Mountains
                </label>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="castles" name="listing[category]" value="Castles" required>
                <label class="form-check-label d-flex align-items-center" for="castles">
                  <i class="fa-brands fa-fort-awesome me-2"></i> Castles
                </label>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="camping" name="listing[category]" value="Camping" required>
                <label class="form-check-label d-flex align-items-center" for="camping">
                  <i class="fa-solid fa-campground me-2"></i> Camping
                </label>
              </div>
            </div>

            <!-- Right Column -->
            <div class="col-md-6">
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="amazing-pools" name="listing[category]" value="Amazing-Pools" required>
                <label class="form-check-label d-flex align-items-center" for="amazing-pools">
                  <i class="fa-solid fa-person-swimming me-2"></i> Amazing Pools
                </label>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="farm" name="listing[category]" value="Farm" required>
                <label class="form-check-label d-flex align-items-center" for="farm">
                  <i class="fa-solid fa-cow me-2"></i> Farm
                </label>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="arctic" name="listing[category]" value="Arctic" required>
                <label class="form-check-label d-flex align-items-center" for="arctic">
                  <i class="fa-solid fa-snowflake me-2"></i> Arctic
                </label>
              </div>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" id="boat" name="listing[category]" value="Boat" required>
                <label class="form-check-label d-flex align-items-center" for="boat">
                  <i class="fa-solid fa-sailboat me-2"></i> Boat
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="invalid-feedback">Choose Category</div>
      </div>

      <!-- Price + Country -->
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="₹ 1200"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Price should be valid</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input
            name="listing[country]"
            placeholder="India"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country name should be valid</div>
        </div>
      </div>

      <!-- Location -->
      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          name="listing[location]"
          placeholder="Delhi, New Delhi"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <!-- Submit -->
      <div class="text-center">
        <button class="btn btn-dark px-4 add-btn mb-3">Add</button>
      </div>
    </form>
  </div>
</div>

<!-- //Dropdown Choose category functionality -->

<script>
const toggleBtn = document.getElementById("categoryToggle"); //button
const optionsBox = document.getElementById("categoryOptions"); //div options

toggleBtn.addEventListener("click", () => {
  optionsBox.classList.toggle("d-none");
});

document
  .querySelectorAll('input[name="listing[category]"]')
  .forEach((radio) => {
    radio.addEventListener("change", function () {
      toggleBtn.textContent = this.nextElementSibling.textContent.trim();
      optionsBox.classList.add("d-none");
    });
  });
</script>